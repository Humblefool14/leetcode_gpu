[tasks]
bmc
prove
prove_n5
[options]
bmc: mode bmc
bmc: depth 2
prove: mode prove
prove_n5: mode prove
[engines]
bmc: abc bmc3
prove: abc pdr
prove_n5: abc pdr
[script]
read -formal ad_vf_vc_penc.v fv_ad_vf_vc_penc.sv
prove_n5: chparam -set N 5 -set W 3 fv_ad_vf_vc_penc
prep -top fv_ad_vf_vc_penc
[files]
../../rtl/vf/vc/ad_vf_vc_penc.v
fv_ad_vf_vc_penc.sv
