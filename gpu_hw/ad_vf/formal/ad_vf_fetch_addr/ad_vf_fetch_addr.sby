[tasks]
bmc
prove
prove64
[options]
bmc: mode bmc
bmc: depth 1
prove: mode prove
prove64: mode prove
[engines]
bmc: abc bmc3
prove: abc pdr
prove64: abc pdr
[script]
read -formal ad_vf_fetch_addr.v fv_ad_vf_fetch_addr.sv
prove64: chparam -set LS 6 fv_ad_vf_fetch_addr
prep -top fv_ad_vf_fetch_addr
[files]
../../rtl/vf/fetch/ad_vf_fetch_addr.v
fv_ad_vf_fetch_addr.sv
