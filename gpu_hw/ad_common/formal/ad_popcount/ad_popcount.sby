# generated by scripts/gen_fpv.py: one harness (fv_ad_popcount.sv), one task per configuration
[tasks]
prove_w1
prove_w2
prove_w7
prove_w16
prove_w32

[options]
prove_w1: mode prove
prove_w2: mode prove
prove_w7: mode prove
prove_w16: mode prove
prove_w32: mode prove

[engines]
prove_w1: abc pdr
prove_w2: abc pdr
prove_w7: abc pdr
prove_w16: abc pdr
prove_w32: abc pdr

[script]
read -formal ad_popcount.v fv_ad_popcount.sv
prove_w1: chparam -set W 1 fv_ad_popcount
prove_w2: chparam -set W 2 fv_ad_popcount
prove_w7: chparam -set W 7 fv_ad_popcount
prove_w16: chparam -set W 16 fv_ad_popcount
prove_w32: chparam -set W 32 fv_ad_popcount
prep -top fv_ad_popcount
techmap t:$shiftx
setundef -zero

[files]
../../rtl/common/math/ad_popcount.v
fv_ad_popcount.sv
