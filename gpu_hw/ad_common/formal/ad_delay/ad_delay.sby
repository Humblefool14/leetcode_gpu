# generated by scripts/gen_fpv.py: one harness (fv_ad_delay.sv), one task per configuration
[tasks]
prove_n1_w1
bmc_n1_w1
prove_n2_w4_di
bmc_n2_w8
prove_n6_w4_di
bmc_n6_w8
prove_n9_w4_di
bmc_n9_w33
bmc_n6_w144
bmc_n6_w275
bmc_n6_w538
bmc_n6_w1066

[options]
prove_n1_w1: mode prove
bmc_n1_w1: mode bmc
bmc_n1_w1: depth 7
prove_n2_w4_di: mode prove
bmc_n2_w8: mode bmc
bmc_n2_w8: depth 8
prove_n6_w4_di: mode prove
bmc_n6_w8: mode bmc
bmc_n6_w8: depth 12
prove_n9_w4_di: mode prove
bmc_n9_w33: mode bmc
bmc_n9_w33: depth 15
bmc_n6_w144: mode bmc
bmc_n6_w144: depth 12
bmc_n6_w275: mode bmc
bmc_n6_w275: depth 12
bmc_n6_w538: mode bmc
bmc_n6_w538: depth 12
bmc_n6_w1066: mode bmc
bmc_n6_w1066: depth 12

[engines]
prove_n1_w1: abc pdr
bmc_n1_w1: abc bmc3
prove_n2_w4_di: abc pdr
bmc_n2_w8: abc bmc3
prove_n6_w4_di: abc pdr
bmc_n6_w8: abc bmc3
prove_n9_w4_di: abc pdr
bmc_n9_w33: abc bmc3
bmc_n6_w144: abc bmc3
bmc_n6_w275: abc bmc3
bmc_n6_w538: abc bmc3
bmc_n6_w1066: abc bmc3

[script]
read -formal ad_delay.v fv_ad_delay.sv
prove_n1_w1: chparam -set N 1 fv_ad_delay
prove_n1_w1: chparam -set W 1 fv_ad_delay
bmc_n1_w1: chparam -set N 1 fv_ad_delay
bmc_n1_w1: chparam -set W 1 fv_ad_delay
prove_n2_w4_di: chparam -set N 2 fv_ad_delay
prove_n2_w4_di: chparam -set W 4 fv_ad_delay
bmc_n2_w8: chparam -set N 2 fv_ad_delay
bmc_n2_w8: chparam -set W 8 fv_ad_delay
prove_n6_w4_di: chparam -set N 6 fv_ad_delay
prove_n6_w4_di: chparam -set W 4 fv_ad_delay
bmc_n6_w8: chparam -set N 6 fv_ad_delay
bmc_n6_w8: chparam -set W 8 fv_ad_delay
prove_n9_w4_di: chparam -set N 9 fv_ad_delay
prove_n9_w4_di: chparam -set W 4 fv_ad_delay
bmc_n9_w33: chparam -set N 9 fv_ad_delay
bmc_n9_w33: chparam -set W 33 fv_ad_delay
bmc_n6_w144: chparam -set N 6 fv_ad_delay
bmc_n6_w144: chparam -set W 144 fv_ad_delay
bmc_n6_w275: chparam -set N 6 fv_ad_delay
bmc_n6_w275: chparam -set W 275 fv_ad_delay
bmc_n6_w538: chparam -set N 6 fv_ad_delay
bmc_n6_w538: chparam -set W 538 fv_ad_delay
bmc_n6_w1066: chparam -set N 6 fv_ad_delay
bmc_n6_w1066: chparam -set W 1066 fv_ad_delay
prep -top fv_ad_delay
techmap t:$shiftx
setundef -zero

