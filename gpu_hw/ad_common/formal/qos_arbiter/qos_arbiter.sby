# generated by scripts/gen_fpv.py: one harness (fv_qos_arbiter.sv), one task per configuration
[tasks]
prove_n3_hi_burst1
bmc_n3_hi_burst1
prove_n4_hi_burst2
bmc_n4_hi_burst2
prove_n5_hi_burst3
bmc_n5_hi_burst3

[options]
prove_n3_hi_burst1: mode prove
bmc_n3_hi_burst1: mode bmc
bmc_n3_hi_burst1: depth 24
prove_n4_hi_burst2: mode prove
bmc_n4_hi_burst2: mode bmc
bmc_n4_hi_burst2: depth 24
prove_n5_hi_burst3: mode prove
bmc_n5_hi_burst3: mode bmc
bmc_n5_hi_burst3: depth 24

[engines]
prove_n3_hi_burst1: abc pdr
bmc_n3_hi_burst1: abc bmc3
prove_n4_hi_burst2: abc pdr
bmc_n4_hi_burst2: abc bmc3
prove_n5_hi_burst3: abc pdr
bmc_n5_hi_burst3: abc bmc3

[script]
read -formal rec_arbiter.sv rr_pick.sv rr_arbiter.sv qos_arbiter.sv fv_qos_arbiter.sv
prove_n3_hi_burst1: chparam -set N 3 fv_qos_arbiter
prove_n3_hi_burst1: chparam -set HI_BURST 1 fv_qos_arbiter
bmc_n3_hi_burst1: chparam -set N 3 fv_qos_arbiter
bmc_n3_hi_burst1: chparam -set HI_BURST 1 fv_qos_arbiter
prove_n4_hi_burst2: chparam -set N 4 fv_qos_arbiter
prove_n4_hi_burst2: chparam -set HI_BURST 2 fv_qos_arbiter
bmc_n4_hi_burst2: chparam -set N 4 fv_qos_arbiter
bmc_n4_hi_burst2: chparam -set HI_BURST 2 fv_qos_arbiter
prove_n5_hi_burst3: chparam -set N 5 fv_qos_arbiter
prove_n5_hi_burst3: chparam -set HI_BURST 3 fv_qos_arbiter
bmc_n5_hi_burst3: chparam -set N 5 fv_qos_arbiter
bmc_n5_hi_burst3: chparam -set HI_BURST 3 fv_qos_arbiter
prep -top fv_qos_arbiter
techmap t:$shiftx
setundef -zero

[files]
../../rtl/common/arb/rec_arbiter.sv
../../rtl/common/arb/rr_pick.sv
../../rtl/common/arb/rr_arbiter.sv
../../rtl/common/arb/qos_arbiter.sv
fv_qos_arbiter.sv
