# hand-written harness (reduced payload width; N = 2 as every instance)
[tasks]
bmc
prove
bmc16
prove16
cover
[options]
bmc: mode bmc
bmc: depth 24
bmc16: mode bmc
bmc16: depth 20
prove: mode prove
prove16: mode prove
prove16: depth 3
cover: mode cover
cover: depth 12
[engines]
bmc: abc bmc3
bmc16: abc bmc3
prove: abc pdr
prove16: smtbmc z3
cover: smtbmc z3
[script]
read -formal -DAD_FV_MUX rec_arbiter.sv rr_pick.sv ad_amb_mux.v ad_amb_client_props.sv fv_ad_amb_mux.sv
bmc16: chparam -set TL 4 fv_ad_amb_mux
prove16: chparam -set TL 4 fv_ad_amb_mux
prep -top fv_ad_amb_mux
[files]
../../rtl/common/bus/ad_amb_mux.v
../../rtl/common/arb/rec_arbiter.sv
../../rtl/common/arb/rr_pick.sv
../common/ad_amb_client_props.sv
fv_ad_amb_mux.sv
