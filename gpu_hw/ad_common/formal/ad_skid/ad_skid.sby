# generated by scripts/gen_fpv.py: one harness (fv_ad_skid.sv), one task per configuration
[tasks]
prove_w1
bmc_w1
prove_w4_di
bmc_w8
bmc_w64
bmc_w719

[options]
prove_w1: mode prove
bmc_w1: mode bmc
bmc_w1: depth 12
prove_w4_di: mode prove
bmc_w8: mode bmc
bmc_w8: depth 12
bmc_w64: mode bmc
bmc_w64: depth 12
bmc_w719: mode bmc
bmc_w719: depth 12

[engines]
prove_w1: abc pdr
bmc_w1: abc bmc3
prove_w4_di: abc pdr
bmc_w8: abc bmc3
bmc_w64: abc bmc3
bmc_w719: abc bmc3

[script]
read -formal ad_skid.v fv_ad_skid.sv
prove_w1: chparam -set W 1 fv_ad_skid
bmc_w1: chparam -set W 1 fv_ad_skid
prove_w4_di: chparam -set W 4 fv_ad_skid
bmc_w8: chparam -set W 8 fv_ad_skid
bmc_w64: chparam -set W 64 fv_ad_skid
bmc_w719: chparam -set W 719 fv_ad_skid
prep -top fv_ad_skid
techmap t:$shiftx
setundef -zero

[files]
../../rtl/common/pipe/ad_skid.v
fv_ad_skid.sv
