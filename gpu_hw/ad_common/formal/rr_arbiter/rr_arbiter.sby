# generated by scripts/gen_fpv.py: one harness (fv_rr_arbiter.sv), one task per configuration
[tasks]
prove_n3
bmc_n3
prove_n5
bmc_n5
prove_n8
bmc_n8

[options]
prove_n3: mode prove
bmc_n3: mode bmc
bmc_n3: depth 24
prove_n5: mode prove
bmc_n5: mode bmc
bmc_n5: depth 24
prove_n8: mode prove
bmc_n8: mode bmc
bmc_n8: depth 24

[engines]
prove_n3: abc pdr
bmc_n3: abc bmc3
prove_n5: abc pdr
bmc_n5: abc bmc3
prove_n8: abc pdr
bmc_n8: abc bmc3

[script]
read -formal rec_arbiter.sv rr_pick.sv rr_arbiter.sv qos_arbiter.sv fv_rr_arbiter.sv
prove_n3: chparam -set N 3 fv_rr_arbiter
bmc_n3: chparam -set N 3 fv_rr_arbiter
prove_n5: chparam -set N 5 fv_rr_arbiter
bmc_n5: chparam -set N 5 fv_rr_arbiter
prove_n8: chparam -set N 8 fv_rr_arbiter
bmc_n8: chparam -set N 8 fv_rr_arbiter
prep -top fv_rr_arbiter
techmap t:$shiftx
setundef -zero

[files]
../../rtl/common/arb/rec_arbiter.sv
../../rtl/common/arb/rr_pick.sv
../../rtl/common/arb/rr_arbiter.sv
../../rtl/common/arb/qos_arbiter.sv
fv_rr_arbiter.sv
