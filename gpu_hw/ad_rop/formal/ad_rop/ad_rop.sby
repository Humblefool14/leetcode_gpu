# cover_open: the cover goal (a quad reaches an accepted AMB request) is reached at step 7 with smtbmc z3,
# but writing the witness trace for this wide design does not finish within 15 minutes, so the task
# is not part of the regression. Reachability is also shown by ad_rop_sys_tb in simulation.
[tasks]
bmc
cover_open
[options]
bmc: mode bmc
bmc: depth 20
cover_open: mode cover
cover_open: depth 14
[engines]
bmc: abc bmc3
cover_open: smtbmc z3
[script]
read -formal -I. ad_amb_mux.v rec_arbiter.sv rr_pick.sv fv_bb.v ad_f2unorm.v ad_fp_cmp.v ad_rop_f2u8.v ad_unorm2f.v ad_fmt_info.v ad_fmt_pack.v ad_rop.v ad_rop_ds.v ad_rop_ms.v ad_rop_occ.v ad_rop_order.v ad_rop_wb.v ad_rop_wpix.v ad_ds_addr.v ad_ds_dbgcol.v ad_ds_row.v ad_ms_a2c.v ad_ms_cov.v ad_ms_zclamp.v ad_wb_merge.v ad_wpix_old.v ad_wpix_place.v fv_ad_rop.sv ad_amb_client_props.sv
prep -top fv_ad_rop
cover_open: chformal -cover -remove ad_rop_wb ad_rop_wpix ad_rop_ds ad_rop_ms ad_rop_order ad_rop_occ ad_amb_mux
