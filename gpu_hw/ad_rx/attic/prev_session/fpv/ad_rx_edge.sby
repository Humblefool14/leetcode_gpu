# generated by fpv/run_fpv.py
[tasks]
prv

[options]
timeout 600
prv: mode prove
prv: depth 4

[engines]
smtbmc cvc5

[script]
read -formal -DFORMAL ad_rx_pkg.sv ad_rx_f2fix.sv ad_rx_i2f.sv ad_rx_edge.sv
prep -top ad_rx_edge
cutpoint ad_rx_f2fix
cutpoint ad_rx_i2f
flatten
chformal -assert2assume a:src=*ad_rx_i2f.sv*
chformal -assert2assume a:src=*ad_rx_f2fix.sv*

[files]
../rtl/ad_rx_pkg.sv
../rtl/ad_rx_f2fix.sv
../rtl/ad_rx_i2f.sv
../rtl/ad_rx_edge.sv
