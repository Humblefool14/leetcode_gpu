# generated by fpv/run_fpv.py
[tasks]
prv

[options]
timeout 600
prv: mode prove
prv: depth 4

[engines]
smtbmc cvc5

[script]
read -formal -DFORMAL ad_rx_pkg.sv ad_rx_setup_uc.sv ad_rx_edge.sv ad_rx_f2fix.sv ad_rx_i2f.sv ad_rx_fadd.sv ad_rx_fmul.sv ad_rx_fdiv.sv ad_rx_setup.sv
prep -top ad_rx_setup
cutpoint ad_rx_edge
cutpoint ad_rx_fadd
cutpoint ad_rx_fmul
cutpoint ad_rx_fdiv
cutpoint ad_rx_f2fix
flatten
chformal -assert2assume a:src=*ad_rx_edge.sv*
chformal -assert2assume a:src=*ad_rx_fdiv.sv*
chformal -assert2assume a:src=*ad_rx_setup_uc.sv*
chformal -assert2assume a:src=*ad_rx_fadd.sv*
chformal -assert2assume a:src=*ad_rx_fmul.sv*
chformal -assert2assume a:src=*ad_rx_i2f.sv*
chformal -assert2assume a:src=*ad_rx_f2fix.sv*

[files]
../rtl/ad_rx_pkg.sv
../rtl/ad_rx_setup_uc.sv
../rtl/ad_rx_edge.sv
../rtl/ad_rx_f2fix.sv
../rtl/ad_rx_i2f.sv
../rtl/ad_rx_fadd.sv
../rtl/ad_rx_fmul.sv
../rtl/ad_rx_fdiv.sv
../rtl/ad_rx_setup.sv
