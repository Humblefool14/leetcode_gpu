# generated by fpv/run_fpv.py
[tasks]
prv

[options]
timeout 600
prv: mode prove
prv: depth 4

[engines]
smtbmc cvc5

[script]
read -formal -DFORMAL ad_rx_pkg.sv ad_rx_fadd.sv ad_rx_fmul.sv ad_rx_fdiv.sv ad_rx_cpoly.sv
prep -top ad_rx_cpoly
cutpoint ad_rx_fadd
cutpoint ad_rx_fmul
cutpoint ad_rx_fdiv
flatten
chformal -assert2assume a:src=*ad_rx_fdiv.sv*
chformal -assert2assume a:src=*ad_rx_fadd.sv*
chformal -assert2assume a:src=*ad_rx_fmul.sv*

[files]
../rtl/ad_rx_pkg.sv
../rtl/ad_rx_fadd.sv
../rtl/ad_rx_fmul.sv
../rtl/ad_rx_fdiv.sv
../rtl/ad_rx_cpoly.sv
