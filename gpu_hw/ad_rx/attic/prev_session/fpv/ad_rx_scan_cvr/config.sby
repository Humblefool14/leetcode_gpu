# generated by fpv/run_fpv.py
[options]
timeout 600
mode cover
depth 30

[engines]
smtbmc cvc5

[script]
read -formal -DFORMAL ad_rx_pkg.sv ad_rx_coarse.sv ad_rx_cov.sv ad_rx_hiz.sv ad_rx_i2f.sv ad_rx_fadd.sv ad_rx_fmul.sv ad_rx_scan.sv
chparam -set HZ_EN 0 ad_rx_scan
prep -top ad_rx_scan
cutpoint ad_rx_fadd
cutpoint ad_rx_fmul
cutpoint ad_rx_i2f
flatten
chformal -assert2assume a:src=*ad_rx_coarse.sv*
chformal -assert2assume a:src=*ad_rx_cov.sv*
chformal -assert2assume a:src=*ad_rx_fadd.sv*
chformal -assert2assume a:src=*ad_rx_fmul.sv*
chformal -assert2assume a:src=*ad_rx_i2f.sv*

[files]
../rtl/ad_rx_pkg.sv
../rtl/ad_rx_coarse.sv
../rtl/ad_rx_cov.sv
../rtl/ad_rx_hiz.sv
../rtl/ad_rx_i2f.sv
../rtl/ad_rx_fadd.sv
../rtl/ad_rx_fmul.sv
../rtl/ad_rx_scan.sv
