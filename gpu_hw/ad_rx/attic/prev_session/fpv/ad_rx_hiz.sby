# generated by fpv/run_fpv.py
[tasks]
prv
cvr

[options]
prv: mode prove
prv: depth 4
cvr: mode cover
cvr: depth 40

[engines]
smtbmc cvc5

[script]
read -formal -DFORMAL ad_rx_pkg.sv ad_rx_hiz.sv
chparam -set AW 3 ad_rx_hiz
chparam -set GW 2 ad_rx_hiz
chparam -set ZW 3 ad_rx_hiz
prep -top ad_rx_hiz

[files]
../rtl/ad_rx_pkg.sv
../rtl/ad_rx_hiz.sv
