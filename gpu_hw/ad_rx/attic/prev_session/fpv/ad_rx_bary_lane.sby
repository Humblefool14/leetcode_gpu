# generated by fpv/run_fpv.py
[tasks]
prv
cvr
bmc

[options]
timeout 600
prv: mode prove
prv: depth 4
cvr: mode cover
cvr: depth 54
bmc: mode bmc
bmc: depth 52

[engines]
smtbmc cvc5

[script]
bmc: read -formal -DFORMAL -DFPV_BMC ad_rx_pkg.sv ad_rx_fadd.sv ad_rx_fmul.sv ad_rx_fdiv.sv ad_rx_bary_lane.sv
~bmc: read -formal -DFORMAL ad_rx_pkg.sv ad_rx_fadd.sv ad_rx_fmul.sv ad_rx_fdiv.sv ad_rx_bary_lane.sv
prep -top ad_rx_bary_lane
flatten
chformal -assert2assume a:src=*ad_rx_fadd.sv*
chformal -assert2assume a:src=*ad_rx_fmul.sv*

[files]
../rtl/ad_rx_pkg.sv
../rtl/ad_rx_fadd.sv
../rtl/ad_rx_fmul.sv
../rtl/ad_rx_fdiv.sv
../rtl/ad_rx_bary_lane.sv
