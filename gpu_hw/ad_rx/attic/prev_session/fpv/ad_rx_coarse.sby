# generated by fpv/run_fpv.py
[tasks]
prv
cvr
bmc

[options]
prv: mode prove
prv: depth 3
cvr: mode cover
cvr: depth 24
bmc: mode bmc
bmc: depth 16

[engines]
smtbmc cvc5

[script]
bmc: read -formal -DFORMAL -DFPV_BMC ad_rx_pkg.sv ad_rx_coarse.sv
~bmc: read -formal -DFORMAL ad_rx_pkg.sv ad_rx_coarse.sv
chparam -set EW 32 ad_rx_coarse
chparam -set CW 8 ad_rx_coarse
prep -top ad_rx_coarse
flatten

[files]
../rtl/ad_rx_pkg.sv
../rtl/ad_rx_coarse.sv
