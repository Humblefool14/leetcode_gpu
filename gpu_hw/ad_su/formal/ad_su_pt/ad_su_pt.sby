[tasks]
bmc
prove

[options]
bmc: mode bmc
bmc: depth 12
prove: mode prove

[engines]
bmc: abc bmc3
prove: abc pdr

[script]
read -formal -I. ad_su_scrub.v ad_gfx_popc32.v ad_gfx_pt_alloc.v ad_su_pt.v
bmc: read -formal -I. -DDATA fv_ad_su_pt.sv
prove: read -formal -I. fv_ad_su_pt.sv
prep -top fv_ad_su_pt
memory_map
techmap -map +/techmap.v t:$shiftx
setundef -zero

[files]
../../rtl/include/ad_su_uop.vh
../../rtl/su/ad_su_scrub.v
../../rtl/su/gfx/ad_gfx_popc32.v
../../rtl/su/gfx/ad_gfx_pt_alloc.v
../../rtl/su/ad_su_pt.v
fv_ad_su_pt.sv
