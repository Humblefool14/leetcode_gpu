[tasks]
bmc
prove_open

[options]
bmc: mode bmc
bmc: depth 16
prove_open: mode prove
prove_open: timeout 300

[engines]
bmc: abc bmc3
prove_open: abc pdr

[script]
read -formal -I. ad_ctl_sb_sil.v fv_ad_ctl_sb_sil.sv
prove_open: chparam -set NPHYS 32 -set SL 2 -set OQ 2 fv_ad_ctl_sb_sil
prep -top fv_ad_ctl_sb_sil

[files]
../../rtl/include/ad_su_uop.vh
../../rtl/su/ctl/ad_ctl_sb_sil.v
fv_ad_ctl_sb_sil.sv
