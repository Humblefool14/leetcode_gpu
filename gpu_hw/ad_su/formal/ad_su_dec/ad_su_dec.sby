[tasks]
bmc
prove
cover
prove64

[options]
bmc: mode bmc
bmc: depth 12
prove: mode prove
prove64: mode prove
cover: mode cover
cover: depth 6

[engines]
bmc: abc bmc3
prove: abc pdr
prove64: abc pdr
cover: smtbmc z3

[script]
read -formal ad_su_dec.v ad_su_dec_core.v ad_su_dec_tab.v ad_su_dec_tabc.v ad_su_dec_fld.v ad_su_dec_imm.v ad_su_dec_chk.v fv_ad_su_dec.sv
prove64: chparam -set NREGS 64 -set PACKED 1 -set SUBGROUP 1 -set HAS_SA 1 -set MS4 1 fv_ad_su_dec
prep -top fv_ad_su_dec

[files]
../../rtl/su/ad_su_dec.v
../../rtl/su/dec/ad_su_dec_core.v
