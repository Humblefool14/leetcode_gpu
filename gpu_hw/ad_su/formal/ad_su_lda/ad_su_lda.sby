[tasks]
bmc
prove
bmc16
prove16
bmc8
prove8

[options]
bmc: mode bmc
bmc: depth 16
bmc16: mode bmc
bmc16: depth 16
bmc8: mode bmc
bmc8: depth 16
prove: mode prove
prove16: mode prove
prove8: mode prove

[engines]
bmc: abc bmc3
bmc16: abc bmc3
bmc8: abc bmc3
prove: abc pdr
prove16: abc pdr
prove8: abc pdr

[script]
read -formal -I. ad_su_scrub.v ad_su_lda.v
read -formal -I. fv_ad_su_lda.sv
bmc16: chparam -set NP 16 fv_ad_su_lda
prove16: chparam -set NP 16 fv_ad_su_lda
bmc8: chparam -set NP 8 fv_ad_su_lda
prove8: chparam -set NP 8 fv_ad_su_lda
prep -top fv_ad_su_lda

[files]
../../rtl/include/ad_su_uop.vh
../../rtl/su/ad_su_scrub.v
../../rtl/su/ad_su_lda.v
fv_ad_su_lda.sv
