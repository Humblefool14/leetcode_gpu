[tasks]
bmc
prove

[options]
bmc: mode bmc
bmc: depth 2
prove: mode prove

[engines]
bmc: abc bmc3
prove: abc pdr

[script]
read -formal ad_lane_sub.v
read -formal fv_ad_lane_sub.sv
prep -top fv_ad_lane_sub
flatten
techmap t:$shiftx
opt_clean
setundef -zero

[files]
../../rtl/su/lane/ad_lane_sub.v
fv_ad_lane_sub.sv
